{
  "manifest_version": 3,
  "name": "KK-MALL Auto Order",
  "version": "1.0.0",
  "description": "Tự đặt hàng tại nguồn (Tiki) cho lệnh mua KK-MALL - chủ sở hữu chỉ nhập OTP. (c) 2026 Nguyễn Duy Điển (KK-2026).",
  "permissions": ["storage", "tabs", "alarms", "notifications"],
  "host_permissions": ["https://tiki.vn/*", "https://www.kk-mall.com/*", "https://script.google.com/*", "https://script.googleusercontent.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["https://tiki.vn/*"], "js": ["lib.js", "tiki.js"], "run_at": "document_idle" }],
  "action": { "default_title": "KK-MALL Auto Order", "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" } },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
